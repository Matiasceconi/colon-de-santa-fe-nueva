{
  "name": "CatapultReport",
  "type": "object",
  "properties": {
    "player_id": {
      "type": "string",
      "description": "ID del jugador (relaci\u00f3n con Player)"
    },
    "player_name": {
      "type": "string",
      "description": "Nombre del jugador en el CSV (para referencia)"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Fecha del reporte"
    },
    "session_id": {
      "type": "string",
      "description": "ID de la sesi\u00f3n asociada"
    },
    "session_label": {
      "type": "string",
      "description": "Etiqueta de la sesi\u00f3n"
    },
    "file_url": {
      "type": "string",
      "description": "URL del archivo CSV original"
    },
    "pdf_url": {
      "type": "string",
      "description": "URL del informe PDF diario"
    },
    "total_duration": {
      "type": "number",
      "description": "Duraci\u00f3n total (minutos)"
    },
    "total_distance": {
      "type": "number",
      "description": "Distancia total (m)"
    },
    "distance_hsr": {
      "type": "number",
      "description": "Distancia 19.8-25 km/h (m)"
    },
    "sprint_distance": {
      "type": "number",
      "description": "Distancia +25 km/h (m)"
    },
    "sprint_efforts": {
      "type": "number",
      "description": "Sprint Efforts"
    },
    "accelerations": {
      "type": "number",
      "description": "Aceleraciones +3 m/s\u00b2"
    },
    "decelerations": {
      "type": "number",
      "description": "Desaceleraciones +3 m/s\u00b2"
    },
    "player_load": {
      "type": "number",
      "description": "Player Load"
    },
    "max_velocity": {
      "type": "number",
      "description": "Velocidad m\u00e1xima (km/h)"
    },
    "max_velocity_percentage": {
      "type": "number",
      "description": "% Vel. M\u00e1xima"
    },
    "meters_per_minute": {
      "type": "number",
      "description": "Metros por minuto"
    },
    "distance_14_19": {
      "type": "number",
      "description": "Distancia 14\u201319.8 km/h (m)"
    },
    "rhie": {
      "type": "number",
      "description": "RHIE Total Bouts"
    },
    "total_source": {
      "type": "string",
      "description": "csv_total, sum_halves u observed_half; no equivale a minutos oficiales"
    },
    "parser_version": {
      "type": "number"
    },
    "periods": {
      "type": "array",
      "description": "Carga GPS por tiempo. Detalle interno: no agregar al total nuevamente.",
      "items": {
        "type": "object",
        "properties": {
          "period": {
            "type": "string",
            "enum": [
              "first_half",
              "second_half"
            ]
          },
          "total_duration": {
            "type": "number",
            "description": "Duraci\u00f3n total (minutos)"
          },
          "total_distance": {
            "type": "number",
            "description": "Distancia total (m)"
          },
          "distance_hsr": {
            "type": "number",
            "description": "Distancia 19.8-25 km/h (m)"
          },
          "sprint_distance": {
            "type": "number",
            "description": "Distancia +25 km/h (m)"
          },
          "sprint_efforts": {
            "type": "number",
            "description": "Sprint Efforts"
          },
          "accelerations": {
            "type": "number",
            "description": "Aceleraciones +3 m/s\u00b2"
          },
          "decelerations": {
            "type": "number",
            "description": "Desaceleraciones +3 m/s\u00b2"
          },
          "player_load": {
            "type": "number",
            "description": "Player Load"
          },
          "max_velocity": {
            "type": "number",
            "description": "Velocidad m\u00e1xima (km/h)"
          },
          "max_velocity_percentage": {
            "type": "number",
            "description": "% Vel. M\u00e1xima"
          },
          "meters_per_minute": {
            "type": "number",
            "description": "Metros por minuto"
          },
          "distance_14_19": {
            "type": "number",
            "description": "Distancia 14\u201319.8 km/h (m)"
          },
          "rhie": {
            "type": "number",
            "description": "RHIE Total Bouts"
          }
        }
      }
    }
  },
  "required": [
    "date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}