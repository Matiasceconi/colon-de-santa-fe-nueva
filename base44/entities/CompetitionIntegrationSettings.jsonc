{
  "name": "CompetitionIntegrationSettings",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "description": "Proveedor externo principal de competencias (ej: promiedos, api_football)"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Si la integraci\u00f3n de competencias est\u00e1 habilitada"
    },
    "provider_time_adjustment_minutes": {
      "type": "number",
      "default": 0.0,
      "description": "Ajuste en minutos aplicado al horario crudo del proveedor antes de guardarlo como hora local del club"
    },
    "calendar_sync_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Si los pr\u00f3ximos partidos integrados deben vincularse al calendario"
    },
    "calendar_sync_squad_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Planteles cuyos pr\u00f3ximos partidos se sincronizan al calendario"
    },
    "calendar_lookahead_days": {
      "type": "number",
      "default": 90.0,
      "description": "Cantidad de d\u00edas futuros a sincronizar al calendario"
    },
    "calendar_auto_create_match_reports": {
      "type": "boolean",
      "default": false,
      "description": "Si adem\u00e1s del evento de calendario se crea autom\u00e1ticamente un MatchReport operativo"
    },
    "last_calendar_sync_at": {
      "type": "string",
      "description": "\u00daltima sincronizaci\u00f3n de pr\u00f3ximos partidos hacia DayEvent"
    },
    "updated_at": {
      "type": "string",
      "description": "Fecha/hora l\u00f3gica de actualizaci\u00f3n"
    },
    "notes": {
      "type": "string",
      "description": "Notas t\u00e9cnicas de configuraci\u00f3n del proveedor"
    }
  },
  "required": [
    "provider"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}