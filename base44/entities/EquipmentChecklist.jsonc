{
  "name": "EquipmentChecklist",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "squad_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "event_date": {
      "type": "string",
      "format": "date"
    },
    "context_type": {
      "type": "string",
      "enum": [
        "training",
        "match",
        "travel",
        "tournament",
        "other"
      ],
      "default": "training"
    },
    "match_id": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "prepared",
        "checked",
        "closed"
      ],
      "default": "draft"
    },
    "responsible_name": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "Lista operativa congelada: item_id, name, size, required_qty, prepared_qty, returned_qty, notes"
    },
    "notes": {
      "type": "string"
    },
    "checked_at": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "event_date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}