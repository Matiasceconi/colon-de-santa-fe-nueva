{
  "name": "EquipmentMovement",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "squad_id": {
      "type": "string"
    },
    "item_id": {
      "type": "string"
    },
    "item_name": {
      "type": "string"
    },
    "movement_type": {
      "type": "string",
      "enum": [
        "intake",
        "issue",
        "return",
        "adjustment",
        "loss",
        "damage",
        "laundry_out",
        "laundry_in"
      ],
      "default": "adjustment"
    },
    "quantity": {
      "type": "number"
    },
    "movement_date": {
      "type": "string",
      "format": "date"
    },
    "player_id": {
      "type": "string"
    },
    "player_name": {
      "type": "string"
    },
    "staff_name": {
      "type": "string"
    },
    "context_type": {
      "type": "string",
      "enum": [
        "training",
        "match",
        "travel",
        "season",
        "laundry",
        "other"
      ],
      "default": "other"
    },
    "context_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "item_id",
    "movement_type",
    "quantity"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}