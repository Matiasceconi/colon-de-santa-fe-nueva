{
  "name": "NutritionControl",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "squad_id": {
      "type": "string"
    },
    "season_id": {
      "type": "string"
    },
    "player_id": {
      "type": "string",
      "description": "Jugador oficial vinculado"
    },
    "player_name": {
      "type": "string"
    },
    "control_date": {
      "type": "string",
      "format": "date"
    },
    "control_time": {
      "type": "string"
    },
    "control_type": {
      "type": "string",
      "enum": [
        "habitual",
        "peso",
        "antropometria",
        "hidratacion",
        "alimentacion",
        "seguimiento_plan",
        "suplementacion",
        "retorno_lesion",
        "otro"
      ],
      "default": "habitual"
    },
    "reason": {
      "type": "string"
    },
    "responsible_user_id": {
      "type": "string"
    },
    "responsible_name": {
      "type": "string"
    },
    "next_control_date": {
      "type": "string",
      "format": "date"
    },
    "weight_kg": {
      "type": "number"
    },
    "height_cm": {
      "type": "number"
    },
    "appetite": {
      "type": "string",
      "enum": [
        "muy_bajo",
        "bajo",
        "normal",
        "alto",
        "muy_alto"
      ]
    },
    "plan_adherence": {
      "type": "string",
      "enum": [
        "muy_baja",
        "baja",
        "adecuada",
        "muy_buena"
      ]
    },
    "missed_meals": {
      "type": "number"
    },
    "breakfast_status": {
      "type": "string",
      "enum": [
        "si",
        "parcial",
        "no",
        "no_aplica"
      ]
    },
    "pre_training_nutrition": {
      "type": "string",
      "enum": [
        "adecuada",
        "parcial",
        "no",
        "no_aplica"
      ]
    },
    "post_training_recovery": {
      "type": "string",
      "enum": [
        "adecuada",
        "parcial",
        "no",
        "no_aplica"
      ]
    },
    "gi_symptoms": {
      "type": "boolean",
      "default": false
    },
    "gi_symptom_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "food_notes": {
      "type": "string"
    },
    "hydration_measured": {
      "type": "boolean",
      "default": false
    },
    "pre_weight_kg": {
      "type": "number"
    },
    "post_weight_kg": {
      "type": "number"
    },
    "fluid_intake_ml": {
      "type": "number"
    },
    "urine_output_ml": {
      "type": "number"
    },
    "activity_duration_min": {
      "type": "number"
    },
    "urine_specific_gravity": {
      "type": "number"
    },
    "urine_color": {
      "type": "number"
    },
    "temperature_c": {
      "type": "number"
    },
    "body_mass_change_pct": {
      "type": "number"
    },
    "estimated_sweat_loss_l": {
      "type": "number"
    },
    "sweat_rate_l_h": {
      "type": "number"
    },
    "intervention": {
      "type": "string",
      "enum": [
        "sin_intervencion",
        "seguimiento",
        "ajustar_plan",
        "citar_jugador",
        "derivar",
        "otro"
      ],
      "default": "sin_intervencion"
    },
    "shared_summary": {
      "type": "string",
      "description": "Resumen operativo que puede compartirse con otras \u00e1reas autorizadas"
    },
    "private_notes": {
      "type": "string",
      "description": "Notas internas del \u00e1rea de Nutrici\u00f3n"
    },
    "source": {
      "type": "string",
      "enum": [
        "app",
        "import"
      ],
      "default": "app"
    },
    "created_by_name": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_by_name": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "player_id",
    "control_date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}