{
  "name": "Player",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "description": "ID del club propietario del jugador"
    },
    "club_name": {
      "type": "string",
      "description": "Nombre del club propietario"
    },
    "squad_id": {
      "type": "string",
      "description": "ID del plantel principal actual"
    },
    "squad_name": {
      "type": "string",
      "description": "Nombre del plantel principal actual"
    },
    "dni": {
      "type": "string",
      "description": "DNI \u00fanico del jugador \u2014 identificador estable",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "document_type": {
      "type": "string",
      "description": "Tipo de documento (DNI, Pasaporte, C\u00e9dula, Otro)"
    },
    "document_number": {
      "type": "string",
      "description": "DNI / Documento (alias de dni para compatibilidad)",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "first_name": {
      "type": "string",
      "description": "Nombre"
    },
    "last_name": {
      "type": "string",
      "description": "Apellido"
    },
    "full_name": {
      "type": "string",
      "description": "Nombre completo (generado autom\u00e1ticamente)"
    },
    "normalized_name": {
      "type": "string",
      "description": "Nombre normalizado para b\u00fasqueda (min\u00fascula, sin tildes)"
    },
    "birth_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de nacimiento"
    },
    "age": {
      "type": "number",
      "description": "Edad calculada"
    },
    "nationality": {
      "type": "string",
      "description": "Nacionalidad"
    },
    "category": {
      "type": "string",
      "description": "Categor\u00eda opcional (ej: 2005, Sub-20, Juvenil). No reemplaza al plantel."
    },
    "division": {
      "type": "string",
      "description": "Texto legado de divisi\u00f3n/equipo. La relaci\u00f3n can\u00f3nica de plantel es SquadMembership -> Squad."
    },
    "current_residence": {
      "type": "string",
      "description": "Clasificaci\u00f3n de residencia legada. Se conserva por compatibilidad; usar residence_zone para nuevos flujos."
    },
    "residence_zone": {
      "type": "string",
      "enum": [
        "AMBA",
        "INTERIOR",
        "EXTERIOR"
      ],
      "description": "Zona administrativa de residencia para filtros y an\u00e1lisis"
    },
    "full_address": {
      "type": "string",
      "description": "Domicilio completo actual cuando el jugador no vive en pensi\u00f3n",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "province": {
      "type": "string",
      "description": "Provincia de residencia para jugadores del interior"
    },
    "city": {
      "type": "string",
      "description": "Ciudad/localidad de residencia"
    },
    "phone_number": {
      "type": "string",
      "description": "N\u00famero de celular del jugador",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "housing_type": {
      "type": "string",
      "description": "Tipo de pensi\u00f3n (Sin pensi\u00f3n, Interna, Externa). Vac\u00edo significa sin informaci\u00f3n confirmada."
    },
    "position": {
      "type": "string",
      "description": "Posici\u00f3n principal configurable por el club mediante InstitutionOption(player_position)"
    },
    "position_group": {
      "type": "string",
      "enum": [
        "Arqueros",
        "Defensores",
        "Mediocampistas",
        "Extremos",
        "Delanteros"
      ],
      "description": "Grupo posicional estable usado para an\u00e1lisis y referencias"
    },
    "player_type": {
      "type": "string",
      "enum": [
        "arquero",
        "jugador_campo"
      ],
      "default": "jugador_campo",
      "description": "Tipo de jugador: arquero o jugador de campo"
    },
    "secondary_position": {
      "type": "string",
      "description": "Posici\u00f3n secundaria"
    },
    "dominant_leg": {
      "type": "string",
      "enum": [
        "Derecha",
        "Izquierda",
        "Ambidiestro"
      ],
      "description": "Pierna h\u00e1bil"
    },
    "height": {
      "type": "number",
      "description": "Altura en cm"
    },
    "weight": {
      "type": "number",
      "description": "Peso en kg"
    },
    "status": {
      "type": "string",
      "enum": [
        "Disponible",
        "Lesionado",
        "En recuperaci\u00f3n",
        "Suspendido",
        "Permiso",
        "Selecci\u00f3n",
        "Subio a primera",
        "Bajo a juveniles",
        "Subieron de juveniles",
        "Bajo de primera",
        "Sparring"
      ],
      "default": "Disponible",
      "description": "Estado actual del jugador"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Jugador activo en el plantel"
    },
    "jersey_number": {
      "type": "number",
      "description": "N\u00famero de camiseta"
    },
    "photo_url": {
      "type": "string",
      "description": "Foto de perfil del jugador"
    },
    "birth_place": {
      "type": "string",
      "description": "Lugar de nacimiento"
    },
    "club_housing": {
      "type": "boolean",
      "default": false,
      "description": "Campo legado booleano de pensi\u00f3n. Mantener por compatibilidad; housing_type es la fuente preferida."
    },
    "has_contract": {
      "type": "boolean",
      "default": false,
      "description": "Campo legado booleano de contrato. Mantener por compatibilidad; contract_status diferencia no de sin informaci\u00f3n."
    },
    "contract_status": {
      "type": "string",
      "enum": [
        "Sin informaci\u00f3n",
        "Con contrato",
        "Sin contrato"
      ],
      "default": "Sin informaci\u00f3n",
      "description": "Situaci\u00f3n contractual confirmada del jugador"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "position"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}