{
  "name": "Status",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del estado"
    },
    "order": {
      "type": "number",
      "description": "Orden de visualizaci\u00f3n",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}