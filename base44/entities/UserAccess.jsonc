{
  "name": "UserAccess",
  "type": "object",
  "properties": {
    "staff_id": {
      "type": "string",
      "description": "ID del StaffMember vinculado (obligatorio)"
    },
    "staff_name": {
      "type": "string",
      "description": "Nombre completo del staff (desnormalizado)"
    },
    "user_email": {
      "type": "string",
      "description": "Email autorizado por el club para ingresar a PerformancePitch"
    },
    "user_name": {
      "type": "string",
      "description": "Nombre completo (desnormalizado)"
    },
    "role": {
      "type": "string",
      "description": "Rol de negocio legado (texto libre, mantenido por compatibilidad). Los permisos reales se definen por role_ids"
    },
    "role_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs de AppRole asignados a este usuario. Un usuario puede tener varios roles; los permisos y \u00e1reas se combinan (uni\u00f3n)"
    },
    "squad_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs de planteles asignados. Vac\u00edo = ninguno (salvo all_squads=true)"
    },
    "squad_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Nombres de planteles (desnormalizado)"
    },
    "all_squads": {
      "type": "boolean",
      "default": false,
      "description": "Si true, tiene acceso a todos los planteles"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Autoridad simple del club: true = el correo est\u00e1 habilitado para ingresar; false = acceso suspendido"
    },
    "invitation_status": {
      "type": "string",
      "enum": [
        "not_sent",
        "pending_password",
        "active",
        "disabled"
      ],
      "default": "active",
      "description": "Campo legado/compatibilidad. En flujo v3, active acompa\u00f1a active=true y disabled acompa\u00f1a active=false"
    },
    "password_setup_required": {
      "type": "boolean",
      "default": false,
      "description": "Campo legado. En flujo v3 no bloquea el ingreso; la contrase\u00f1a/verificaci\u00f3n pertenece a autenticaci\u00f3n"
    },
    "invited_at": {
      "type": "string",
      "description": "Fecha ISO del \u00faltimo aviso de acceso enviado"
    },
    "password_setup_requested_at": {
      "type": "string",
      "description": "Fecha ISO del \u00faltimo correo para crear contrase\u00f1a (legado)"
    },
    "password_setup_completed_at": {
      "type": "string",
      "description": "Fecha ISO del primer ingreso correcto con email y contrase\u00f1a (legado)"
    },
    "last_seen": {
      "type": "string",
      "description": "\u00daltimo acceso (ISO datetime). Si est\u00e1 vac\u00edo y active=true, se muestra Pendiente de primer ingreso"
    },
    "notes": {
      "type": "string"
    },
    "activation_version": {
      "type": "integer",
      "description": "Versi\u00f3n del flujo de acceso. 3 = autorizaci\u00f3n simple por email; 2 = activaci\u00f3n privada legacy"
    },
    "authorized_at": {
      "type": "string",
      "description": "Fecha ISO en que el club autoriz\u00f3 el correo"
    },
    "authorized_by_email": {
      "type": "string",
      "description": "Email del administrador que autoriz\u00f3 el acceso"
    }
  },
  "required": [
    "staff_id",
    "user_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}